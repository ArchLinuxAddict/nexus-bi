{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "dataset_id", "summary", "programs"],
  "properties": {
    "schema_version": {"type": "string"},
    "dataset_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dataset_root": {"type": "string"},
    "summary": {"type": "object"},
    "programs": {"type": "array", "minItems": 1},
    "pairs": {"type": "array"},
    "relationship_counts": {"type": "object"},
    "behavioral_verification_sha256": {"type": "string"}
  },
  "additionalProperties": true
}
