{
  "schema_version": "0.1.0",
  "pilot_id": "acquisition_projects_v1",
  "protocol": {
    "max_projects": 30,
    "max_download_bytes": 1500000000,
    "max_storage_bytes": 4000000000,
    "max_archive_bytes": 80000000,
    "max_extract_files": 20000,
    "max_extract_bytes": 1000000000,
    "license_policy": "permissive-only allowlist; unknown, ambiguous, copyleft and source-available licenses are quarantined",
    "allowed_licenses": [
      "MIT",
      "BSD-2-Clause",
      "BSD-3-Clause",
      "Apache-2.0",
      "ISC",
      "Unlicense",
      "CC0-1.0",
      "Zlib",
      "0BSD",
      "WTFPL"
    ],
    "deduplication": "exact archive + source-file hash + 64-dimension 5-token MinHash against the historical 109-project corpus and within-pilot",
    "resumability": "per-project stage state plus resumable HTTP Range downloads and content-hash verification",
    "historical_dataset": "artifacts/dataset/realworld_v6_pilot2",
    "category_balance_target": "no category above 25 percent of accepted projects",
    "exclusions": [
      "GPL",
      "AGPL",
      "LGPL",
      "MPL",
      "source-available",
      "unknown licensing",
      "duplicate projects",
      "vendored mirrors"
    ],
    "notes": [
      "Repository commits are pinned and recorded.",
      "Controlled build recipes are explicit; upstream build systems are not silently substituted.",
      "Public accessibility is not treated as training permission.",
      "No behavioral execution is performed in this phase."
    ]
  },
