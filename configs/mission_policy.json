  "training_rules": {
    "require_objectives": true,
    "require_dataset_categories": true,
    "require_core_objective": true,
    "require_core_dataset_for_main": true,
    "prohibited_classifications": [
      "IRRELEVANT",
      "PROHIBITED"
    ],
    "experimental_requires_justification_for_main": true,
    "reject_unregistered_datasets": true
