  "dataset_categories": {
    "controlled_binary_source": {
      "classification": "CORE",
      "capabilities": [
        "native_binary_understanding",
        "instruction_semantics",
        "function_identification",
        "control_flow_reasoning",
        "c_reconstruction",
        "source_binary_alignment"
      ],
      "rationale": "Source and binary are both available from controlled builds with compiler metadata.",
      "allowed_for_training": true,
      "license_required": true
    },
    "real_world_binary_source": {
      "classification": "CORE",
      "capabilities": [
        "native_binary_understanding",
        "function_identification",
        "control_flow_reasoning",
        "cross_compiler_matching",
        "library_analysis",
        "security_investigation"
      ],
      "rationale": "Real projects with licensed source, exact commits and controlled binaries.",
      "allowed_for_training": true,
      "license_required": true
    },
    "jni_fixtures": {
      "classification": "CORE",
      "capabilities": [
        "java_jni_reconstruction",
