{
  "schema_version": "0.1.0",
  "capabilities": {
    "native_binary_understanding": "Understand raw bytes, executable structure and architecture-specific artifacts.",
    "instruction_semantics": "Interpret instructions, operands, registers, memory effects and control flow.",
    "function_identification": "Recover function boundaries, signatures and relationships.",
    "control_flow_reasoning": "Recover and reason over basic blocks, CFG and call graph.",
    "dataflow_type_inference": "Infer data dependencies, registers, stack values and types.",
    "cross_compiler_matching": "Match equivalent functions across compilers.",
    "cross_optimization_matching": "Match equivalent functions across optimization levels.",
    "source_binary_alignment": "Align source files/functions with binary functions and addresses.",
    "c_reconstruction": "Reconstruct verified C functions, modules and projects.",
    "cpp_reconstruction": "Reconstruct C++ semantics and structure where evidence supports it.",
    "java_jni_reconstruction": "Reconstruct Java/JNI relationships and source.",
    "library_analysis": "Analyze native libraries, dependencies and external interfaces.",
    "behavior_inference": "Infer function purpose, side effects and program behavior.",
    "security_investigation": "Investigate security-relevant behavior with evidence.",
    "autonomous_reverse_engineering": "Plan and execute evidence-driven investigations.",
    "project_reconstruction": "Reconstruct and verify complete projects.",
    "evidence_verification": "Compile, test and verify conclusions with traceable evidence."
  },
